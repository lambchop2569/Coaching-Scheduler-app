{
  "name": "coach-scheduler-bot",
  "version": "1.0.0",
  "description": "Discord bot for coaching scheduling with coach profiles and time-slot buttons",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "activity": "npx http-server public -p 3000"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "discord.js": "^14.16.2",
    "dotenv": "^16.4.1",
    "http-server": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.3"
  }
}
